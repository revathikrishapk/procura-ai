# Copy to .env and add local credentials. Never commit .env.
TAVILY_API_KEY=

# When both OpenRouter settings are present, Procura uses OpenRouter.
# Choose a model available to your OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional OpenRouter attribution headers.
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Procura AI
