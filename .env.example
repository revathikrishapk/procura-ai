# Copy to .env and add local credentials. Never commit .env.
DATABASE_URL=sqlite:///./procura.db
LANGGRAPH_CHECKPOINT_PATH=procura_checkpoints.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TAVILY_API_KEY=

# When both OpenRouter settings are present, Procura uses OpenRouter.
# Choose a model available to your OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional OpenRouter attribution headers.
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Procura AI
